# ==============================================================================
# SMARTDOC ENGINE — BUZÓN INTELIGENTE RIWI BARRANQUILLA
# Variables de Entorno y Configuración
# ==============================================================================

# 1. Google Gemini API (Multimodal VLM para visión profunda y Document Q&A)
# Obtén tu clave en: https://aistudio.google.com/
GEMINI_API_KEY=

# Modelo oficial Gemini recomendado (alta velocidad y razonamiento multimodal)
GEMINI_MODEL=gemini-2.5-flash

# 2. Groq Cloud API (Inferencia ultra-rápida 0.2s mediante LLaMA 3.3 70B - Gratuita)
# Obtén tu clave en: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Ollama Local (Fallback offline opcional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# 4. Umbrales de Calidad de Imagen (OpenCV)
# Varianza Laplaciana por debajo de este valor activa restauración y enfoque
BLUR_VARIANCE_THRESHOLD=120.0
YOLO_CONFIDENCE_THRESHOLD=0.35
